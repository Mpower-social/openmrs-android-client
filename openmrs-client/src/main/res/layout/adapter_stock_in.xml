<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listVisitItemLayoutContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/serial_txt"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="8dp"
            android:text="SN"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/item_txt"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="8dp"
            android:text="Item"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/current_stock_txt"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="8dp"
            android:text="Current Stock"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/quantity_txt"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="10dp"
            android:text="Quantity"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/expire_txt"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="10dp"
            android:text="Expire"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/batch_txt"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="10dp"
            android:text="Batch No"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/received_from_txt"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="1dp"
            android:background="@color/white"
            android:gravity="center"
            android:padding="10dp"
            android:text="Received From"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_margin="1dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/edit_img"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:padding="5dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_edit_white_24dp"
                app:tint="@color/primary" />

            <ImageView
                android:id="@+id/delete_img"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:padding="5dp"
                android:src="@drawable/ic_delete_black_24dp"
                app:tint="@color/primary" />


        </LinearLayout>

    </LinearLayout>


</LinearLayout>
