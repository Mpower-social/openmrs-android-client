<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="org.intelehealth.app.mpower.activities.stockManagement.StockInViewModel" />
    </data>

    <RelativeLayout xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/dashboard_content_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <LinearLayout
                    android:id="@+id/stock_date_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/std_8dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputFromDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableEnd="@drawable/ic_date_range_24dp"
                            android:enabled="false">

                            <EditText
                                android:id="@+id/fromStockInDateEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="From: stock in date"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnFromStockInDate"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/std_8dp"
                            android:background="@drawable/ic_date_range_24dp"
                            android:backgroundTint="?android:attr/textColorPrimary" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/std_8dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutStockInDate"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableEnd="@drawable/ic_date_range_24dp"
                            android:enabled="false">

                            <EditText
                                android:id="@+id/toStockInDateEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="To: stock in date"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnToStockInDate"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/std_8dp"
                            android:background="@drawable/ic_date_range_24dp"
                            android:backgroundTint="?android:attr/textColorPrimary" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/invoice_search_ll"
                    android:layout_below="@id/stock_date_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/std_8dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputInvoice"
                            android:layout_weight="1"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/invoiceEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Invoice"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/std_8dp"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputSearch"
                            android:layout_weight="1"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/itemEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Search by item name"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/searchRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/std_8dp"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />



                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_ll"
                    android:layout_below="@id/invoice_search_ll"
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_below="@id/invoice_search_ll"
                        android:layout_margin="8dp"
                        android:background="@color/primary"
                        android:elevation="0dp"
                        android:padding="@dimen/eight_dp"
                        android:text="Search"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="normal" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_below="@id/invoice_search_ll"
                        android:layout_margin="8dp"
                        android:background="@color/primary"
                        android:elevation="0dp"
                        android:padding="@dimen/eight_dp"
                        android:text="Clear Search"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="normal" />

                </LinearLayout>



                <HorizontalScrollView
                    android:id="@+id/scroll_ll"
                    android:layout_below="@id/btn_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/ll_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/grey"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/serial_txt"
                                android:layout_width="64dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="SN"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/item_txt"
                                android:layout_width="200dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="Item"
                                android:textColor="@color/black" />


                            <TextView
                                android:id="@+id/quantity_txt"
                                android:layout_width="120dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Quantity"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/stock_in_date_txt"
                                android:layout_width="120dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Stock In Date"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/invoice_txt"
                                android:layout_width="120dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Invoice"
                                android:textColor="@color/black" />


                            <TextView
                                android:id="@+id/sync_txt"
                                android:layout_width="150dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Sync Status"
                                android:textColor="@color/black" />

                            <TextView
                                android:id="@+id/provider_txt"
                                android:layout_width="150dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_margin="1dp"
                                android:background="@color/white"
                                android:gravity="center"
                                android:padding="10dp"
                                android:text="Provider"
                                android:textColor="@color/black" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/stockListRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_marginBottom="@dimen/std_8dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </HorizontalScrollView>



            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>


        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStockAdd"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:background="@color/primary"
            android:drawableStart="@drawable/ic_add"
            android:elevation="0dp"
            android:padding="@dimen/eight_dp"
            android:drawablePadding="8dp"
            android:text="Stock In"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="normal" />


    </RelativeLayout>

</layout>